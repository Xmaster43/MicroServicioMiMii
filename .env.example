# ===========================================
# MicroServicioMiMii - Environment Variables
# Copy to .env and adjust values as needed
# ===========================================

# -------------------------------------------
# Database (shared by UserService, ServicioService, ReservaService, ProductService)
# -------------------------------------------
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=

# -------------------------------------------
# Service-to-service communication
# -------------------------------------------
# AuthService → UserService
USERSERVICE_URL=http://localhost:8084

# ReservaService → UserService & ServicioService
# USERSERVICE_URL=http://localhost:8084  # same as above
SERVICIOSERVICE_URL=http://localhost:8083

# -------------------------------------------
# AWS / SQS (ReservaService producer, ProductService consumer)
# -------------------------------------------
# For local development with LocalStack
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_RESERVA_PRODUCT_QUEUE_URL=http://localhost:4566/000000000000/reserva-to-product.fifo

# For AWS deployment, use real values:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# SQS_RESERVA_PRODUCT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/reserva-to-product.fifo

# -------------------------------------------
# Service ports (for reference - not used as env vars)
# -------------------------------------------
# UserService:       8084
# AuthService:       8085
# ServicioService:   8083
# ReservaService:    8086
# ProductService:    8087